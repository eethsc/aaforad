# Optional: leave all values unset to use the built-in deterministic design sandbox.
# Never put this file with real secrets under version control.

# Enables an OpenAI Responses API planning note on the server only.
FUSION_ENABLE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=

# Simulator adapter selection. The current prototype always falls back to its
# deterministic mock adapter when no external simulator is configured.
FUSION_SIMULATOR=mock
NGSPICE_PATH=
CADENCE_PROJECT_DIR=
AGENTIC_SIZING_CADENCE_WORK_ROOT=

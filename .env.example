# Required for the LLM-driven agent loop. Never commit a real key.
FUSION_REQUIRE_LLM=true
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# Simulator adapter selection. `auto` detects ngspice when available.
FUSION_SIMULATOR=auto
NGSPICE_PATH=
PDK_ROOT=
PDK=sky130A
# `sky130A` is the installed profile. Any external PDK needs its own model,
# device vocabulary and simulator adapter; the engine does not reuse SKY130 facts.
PDK_MODEL_FILE=
PDK_CORNER=tt
# Docker Compose pins a reproducible public Volare SKY130 artifact by default.
SKY130_PDK_VERSION=b344c97eacc2aaf8e14ae7e43e2e9dc0871de2c0
CADENCE_PROJECT_DIR=
AGENTIC_SIZING_CADENCE_WORK_ROOT=
